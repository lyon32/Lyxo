{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "experimentalDecorators": true,
    // Globales de Jest (describe/it/expect) dans les *.test.ts — sans ça
    // `tsc --noEmit` échoue sur les fichiers de test alors que la suite passe.
    "types": ["jest"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}